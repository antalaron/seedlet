{
    "name": "antalaron/seedlet",
    "description": "Frontend for Transmission BitTorrent client",
    "keywords": ["transmission", "torrent"],
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "author": [
        {
            "name": "Antal Áron",
            "email": "antalaron@antalaron.hu",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/browser-kit": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/process": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/security-csrf": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/webpack-encore-bundle": "^2.4",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/debug-bundle": "8.1.*",
        "symfony/maker-bundle": "^1.67",
        "symfony/stopwatch": "8.1.*",
        "symfony/web-profiler-bundle": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Antalaron\\Seedlet\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antalaron\\Seedlet\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    }
}
