<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Seedlet{% endblock %}</title>

    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    {{ encore_entry_link_tags('seedlet') }}
    {{ encore_entry_script_tags('seedlet') }}
</head>

<body class="bg-body-tertiary">
    {% block body %}{% endblock %}

    <footer class="footer mt-auto py-3 bg-light">
        <div class="container text-center small">
            <span class="text-muted">
                Seedlet &copy; 2026{% if 'now'|date('Y') > 2026 %}-{{ 'now'|date('y') }}{% endif %}, Antal Áron |
                Made with <i class="fa-solid fa-heart"></i> |
                Open source on <a href="https://github.com/antalaron/seedlet" target="_blank" rel="noopener noreferrer">
                    GitHub
                </a>
            </span>
        </div>
    </footer>
</body>
</html>
